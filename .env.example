# Green Routing configuration — every setting is an environment variable.
# Copy to .env (gitignored), edit, then: set -a; source .env; set +a
# Defaults shown; only the S3 credentials are usually needed.

# --- Data source ---------------------------------------------------------------
# s3 (default) | local | auto (local mirror if it exists, else S3)
GR_DATA_SOURCE=s3
GR_S3_BUCKET=network-energy-efficiency-research
GR_S3_ENDPOINT=https://zhw-b.s3.cloud.switch.ch
GR_S3_REGION=eu-central-1
GR_S3_ADDRESSING=path
# Credentials: an AWS profile in ~/.aws/credentials (recommended), or the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables. Leave empty for the default chain.
GR_S3_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Object cache: every CSV is downloaded once (~22 GB for the whole interface subtree)
GR_S3_CACHE=1
GR_CACHE_DIR=~/.cache/green-routing/s3
GR_S3_WORKERS=8

# Local mirror instead of S3 (GR_DATA_SOURCE=local)
GR_LOCAL_ROOT=~/switch

# --- Outputs ---------------------------------------------------------------------
# Run directories, panel caches, the model zoo (default: <repo>/artifacts)
# GR_ARTIFACTS_DIR=/data/green-routing/artifacts

# --- Optional --------------------------------------------------------------------
# network-energy-efficiency-research checkout (real topology, backbone usage logs);
# default: a sibling directory of this repository
# GR_RESEARCH_ROOT=
# PRED_DEVICE=cuda          # cuda | cpu (default: cuda when available)
# GR_VIEWER_PASSWORD=       # viewer password; default: generated into
#                           # ~/.config/green-routing/viewer_password
