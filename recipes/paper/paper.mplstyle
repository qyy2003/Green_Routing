# The paper's plot style (owner's config, 2026-11-06), adapted to matplotlib 3.11:
# axes.color_cycle -> axes.prop_cycle; "pdf.fonttype = 42" -> "pdf.fonttype: 42";
# ps.usedistiller dropped (PostScript only). text.usetex stays off, also where LaTeX is
# installed (owner's request, round 2): matplotlib's STIX (Times-like) fonts.
font.family: serif
font.serif: Times, Times New Roman, STIXGeneral
mathtext.fontset: stix
font.size: 10
figure.figsize: 3.125, 1.56
legend.fontsize: 8
legend.fancybox: True
axes.linewidth: 0.5
axes.prop_cycle: cycler('color', ['348ABD', 'A60628', '7A68A6', '467821', 'CF4457', '188487', 'E24A33'])
patch.linewidth: 0.5
lines.linewidth: 1
grid.linewidth: 0.25
xtick.major.width: 0.25
xtick.minor.width: 0.25
ytick.major.width: 0.25
ytick.minor.width: 0.25
pdf.fonttype: 42
ps.fonttype: 42
savefig.bbox: tight
savefig.pad_inches: 0.02
